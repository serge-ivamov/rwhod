<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ru.ec.rwhod</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/rwhod</string>
        <string>-p</string>
        <!-- <string>-i</string> -->
        <!-- <string>-m</string>
             <string>ttl</string> -->
    </array>

    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>

    <key>UserName</key><string>daemon</string>
    <key>GroupName</key><string>daemon</string>

    <key>Sockets</key>
    <dict>
        <key>rwhodSocket</key>
        <dict>
            <key>SockServiceName</key><string>who</string>
            <key>SockType</key><string>dgram</string>
            <key>SockFamily</key><string>IPv4</string>
        </dict>
    </dict>

    <key>WorkingDirectory</key><string>/var/rwho</string>

</dict>
</plist>

